{
  "name": "consumer-app-api",
  "version": "1.0.0",
  "description": "Consumer App API - Lead Management System",
  "main": "src/app.js",
  "scripts": {
    "start:local": "nodemon -r dotenv/config src/app.js dotenv_config_path=.env.local",
    "start:dev": "nodemon -r dotenv/config src/app.js dotenv_config_path=.env.dev",
    "start:production": "node -r dotenv/config src/app.js dotenv_config_path=.env.production",
    "setup:admin": "node scripts/createSuperAdmin.js",
    "pm2:dev": "pm2 start ecosystem.config.js --only consumer-app-api-dev",
    "pm2:prod": "pm2 start ecosystem.config.js --only consumer-app-api-prod --env production",
    "pm2:restart:dev": "pm2 restart consumer-app-api-dev",
    "pm2:restart:prod": "pm2 restart consumer-app-api-prod",
    "pm2:stop:dev": "pm2 stop consumer-app-api-dev",
    "pm2:stop:prod": "pm2 stop consumer-app-api-prod",
    "pm2:delete:dev": "pm2 delete consumer-app-api-dev",
    "pm2:delete:prod": "pm2 delete consumer-app-api-prod",
    "pm2:logs:dev": "pm2 logs consumer-app-api-dev",
    "pm2:logs:prod": "pm2 logs consumer-app-api-prod",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "express",
    "mongoose",
    "insurance",
    "leads",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.5.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
