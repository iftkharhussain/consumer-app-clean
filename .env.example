# Environment Configuration
NODE_ENV=development
PORT=3025
CROSS_APP_JWT_SECRET='--------'
ACCESS_TOKEN_SECRET='--------'
WEBSOCKET_TOKEN_SECRET='--------'

# MongoDB Configuration - Consumer App Database
MONGODB_URI=mongodb://localhost:27017/consumer_app

# LMS Database Connection (shared database for leads)
LMS_DB_URI=mongodb://localhost:27017/app

# LMS Server URL (for cross-app API calls)
NORGA_APP_SERVER=http://localhost:3024

# Paperform Webhook Secret (optional)
PAPERFORM_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=info
