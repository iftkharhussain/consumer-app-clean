# Environment Configuration
NODE_ENV=development
PORT=3025

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/lead-management-system
MONGODB_OPTIONS=

# Fortus API Configuration
FORTUS_API_URL=https://ratingwebservices.compu-quote.com/RatingWebService.asmx
FORTUS_USERNAME=your_fortus_username
FORTUS_PASSWORD=your_fortus_password_base64
FORTUS_CALLER_NAME=consumer-app-api
FORTUS_CALLER_VERSION=1.0.0
FORTUS_MAJOR_VERSION=6
FORTUS_MINOR_VERSION=1
FORTUS_BUILD=5

# Paperform Webhook Secret (optional)
PAPERFORM_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=info
